# StreamGrab Environment Configuration
# Copy this file to .env and customize values

# Server binding
STREAMGRAB_HOST=0.0.0.0
STREAMGRAB_PORT=5000

# Environment: 'production' uses Waitress WSGI, 'development' uses Flask dev server
STREAMGRAB_ENV=production

# Secret key (auto-generated if not set, but recommended to set for session persistence)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
STREAMGRAB_SECRET_KEY=

# Custom storage directory (defaults to OS temp directory)
# STREAMGRAB_STORAGE_DIR=/path/to/storage
